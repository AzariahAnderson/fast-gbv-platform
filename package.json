{
  "name": "fast-gbv-platform",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:directory": "bun test tests/directory-integrity.test.ts",
    "test:i18n": "bun test tests/i18n.test.ts",
    "test": "bun test tests/directory-integrity.test.ts tests/i18n.test.ts tests/live-sanitize.test.ts tests/thumb-extract.test.ts tests/db-security.test.ts tests/privacy-helpers.test.ts",
    "test:e2e": "playwright test",
    "db:push": "echo '[fast] no database: FAST keeps no server-side data store; this no-op exists so the sandbox dev harness keeps working'"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-toast": "^1.2.14",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "lucide-react": "^0.525.0",
    "maplibre-gl": "^6.19.0",
    "next": "^16.1.1",
    "next-intl": "^4.3.4",
    "postgres": "^4.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "z-ai-web-dev-sdk": "^0.0.18"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.1",
    "bun-types": "^1.3.4",
    "docx": "^9.16.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
